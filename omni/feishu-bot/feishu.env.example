# ===== 飞书机器人凭据（必填）=====
# 在 https://open.feishu.cn/app 创建企业自建应用，获得 App ID / App Secret。
# 开启机器人能力：应用能力 -> 机器人；权限：im:message、im:message.p2p_msg:readonly、
# im:message.group_msg:readonly（订阅 im.message.receive_v1 用长连接，无需公网回调地址）。
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# ===== pi 运行配置（选填，缺省使用 pi 默认/环境变量）=====
# pi 可执行入口；留空时自动探测（node 运行仓库内构建产物，或 PATH 中的全局 pi）
# PI_BIN=
# 模型 provider 与模型（e.g. openai / claude-sonnet-4-5:high / deepseek）
# PI_PROVIDER=
# PI_MODEL=
# 会话目录（每个飞书会话独立持久化；缺省 ~/.pi/feishu）
# PI_SESSION_DIR=

# ===== LLM API Key（选填其一；或改用 ~/.pi/agent/auth.json）=====
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# KIMI_API_KEY=
# GEMINI_API_KEY=

# ===== 调试 =====
# 打印每条收到的飞书事件（脱敏）与 pi RPC 流量
# PI_FEISHU_DEBUG=1